# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source files & configuration
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files (prevent git line ending conversions & corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
